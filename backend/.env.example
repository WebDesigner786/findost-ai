# ==============================================================================
# FinDost AI Backend — Environment Configuration
# ==============================================================================
# Zero hardcoded credentials. Set your environment variables in .env (or server env).

# Environment: "development", "staging", "production"
ENVIRONMENT=development
DEBUG=true

# API Host & Port
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Format for Supabase Session Pooler / Transaction Pooler (or direct connection):
# postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# If DATABASE_URL is not set or uses sqlite, defaults to local SQLite for zero-config offline runs:
DATABASE_URL=sqlite:///./findost_local.db

# Database Connection Pool Settings (Optimized for Supabase / PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true

# ------------------------------------------------------------------------------
# Authentication & Demo User Settings
# ------------------------------------------------------------------------------
# Accepted demo header for evaluations
DEMO_USER_HEADER=X-Demo-User
DEFAULT_DEMO_USER=demo-findost-judge

# JWT Secret (if backend-issued tokens are enabled)
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
